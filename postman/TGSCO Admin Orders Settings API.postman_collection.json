            {
              "name": "Admin Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/auth/login"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });",
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  const token = body.data && (body.data.accessToken || body.data.token);",
                      "  if (token) pm.collectionVariables.set('admin_token', token);",
                      "  if (body.data && body.data.refreshToken) pm.collectionVariables.set('admin_refresh_token', body.data.refreshToken);",
                      "}"
                    ]
                  }
                }
              ]
            }
