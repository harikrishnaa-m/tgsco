            {
              "name": "Admin Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{base_url}}/auth/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Login succeeded\",()=>pm.response.to.have.status(200));",
                      "if(pm.response.code===200){pm.collectionVariables.set(\"admin_token\",pm.response.json().data.accessToken);pm.collectionVariables.set(\"refresh_token\",pm.response.json().data.refreshToken);}"
                    ]
                  }
                }
              ]
            }
          ]
